FailAt 10
Execute Termic:Setup
CD Termic:Source
; Crypto runs in AmiSSL. Keep the small transport unit at O0.
vc +aos68k -cpu=68020 -O0 -ITermic:SDK/AmiSSL/Developer/include -c tls.c -o tls.o
If WARN
  Quit 20
EndIf
vc +aos68k -cpu=68020 -O1 worker.c agent.c files.c workspace.c http.c tls.o vendor/cJSON.c -o Termic:TermicAgent.new -lamiga -lmieee
If WARN
  Quit 20
EndIf
vc +aos68k -cpu=68020 -O1 -ITermic:SDK/MUI/Developer/C/Include -ITermic:SDK/MCC_TextEditor/Developer/C/include gui.c files.c workspace.c syntax.c -o Termic:TermicNative.new -lamiga
If WARN
  Quit 20
EndIf
vc +aos68k -cpu=68020 -O1 storage.c files.c workspace.c -o Termic:TermicStorage.new -lamiga
If WARN
  Quit 20
EndIf
If EXISTS Termic:TermicStorage
  Delete Termic:TermicStorage
EndIf
Rename Termic:TermicStorage.new Termic:TermicStorage
Protect Termic:TermicStorage +e
If EXISTS Termic:TermicAgent
  Delete Termic:TermicAgent
EndIf
Rename Termic:TermicAgent.new Termic:TermicAgent
If EXISTS Termic:TermicNative
  Delete Termic:TermicNative
EndIf
Rename Termic:TermicNative.new Termic:TermicNative
Protect Termic:TermicAgent +e
Protect Termic:TermicNative +e
Echo "Termic native applications built on this Amiga."
